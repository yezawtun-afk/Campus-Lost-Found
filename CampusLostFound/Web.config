<?xml version="1.0" encoding="utf-8"?>
<!--
    Campus Lost & Found - application configuration.
    The connection string below points at the LocalDB instance on this machine.
    Run Database\LostFoundDB.sql once (see README.txt) before starting the site.
-->
<configuration>
  <appSettings>
    <!-- Use classic (built-in) validator scripts - no jQuery dependency. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <connectionStrings>
    <add name="LostFoundDB"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=LostFoundDB;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="8192" />
    <pages controlRenderingCompatibilityVersion="4.0" />

    <!-- Any unhandled error is redirected to our friendly Error.aspx page. -->
    <customErrors mode="On" defaultRedirect="Error.aspx">
      <error statusCode="404" redirect="Error.aspx" />
    </customErrors>
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>
</configuration>




